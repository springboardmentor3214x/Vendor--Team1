# === REQUIRED ===
DATABASE_URL=postgresql://user:password@host:5432/vendor_db?sslmode=require
SECRET_KEY=your-secret-key-change-this-in-production

# === CORS (comma-separated) ===
# Local dev:
CORS_ORIGINS=http://localhost:4200
# Production (replace with your Vercel URL):
# CORS_ORIGINS=https://your-app.vercel.app

# === Frontend URL (for password reset links) ===
FRONTEND_BASE_URL=http://localhost:4200

# === Database Seeding ===
# Set to "true" to seed demo data on startup (additive, won't wipe)
SEED_ON_STARTUP=false

# === Optional: Email (SMTP) ===
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=no-reply@vrip.local

# === Optional: SMS (Twilio) ===
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
